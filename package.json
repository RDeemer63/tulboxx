{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:migrate:safe": "tsx server/db/migrate.ts --skip-existing",
    "db:studio": "drizzle-kit studio",
    "db:baseline": "tsx server/db/create-baseline.ts",
    "db:seed": "tsx server/db/seed.ts",
    "db:reset": "tsx server/db/reset.ts",
    "db:check-feature-flags": "tsx scripts/check-feature-flags-tables.ts",
    "db:generate-feature-flags-migration": "drizzle-kit generate --config=feature-flags-drizzle.config.ts",
    "db:migrate-feature-flags": "tsx server/db/apply-feature-flags-migration.ts",
    "lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "test": "npm run test:server && npm run test:client",
    "test:server": "jest -c jest.config.js",
    "test:ff": "NODE_OPTIONS=\"--max-old-space-size=4096\" jest --config jest.config.js --runInBand --maxWorkers=1 server/__tests__/routes/feature-flags.test.ts",
    "test:server:light": "NODE_OPTIONS=\"--max-old-space-size=4096\" jest -c jest.config.js --runInBand --maxWorkers=1",
    "test:client": "jest -c jest.client.config.js",
    "test:watch": "jest -c jest.client.config.js --watch",
    "test:coverage": "npm run test:coverage:server && npm run test:coverage:client",
    "test:coverage:server": "jest -c jest.config.js --coverage",
    "test:coverage:client": "jest -c jest.client.config.js --coverage",
    "e2e": "npx playwright test"
  },
